### 获取交易收据信息
GET http://localhost:8080/transactions/{{tx_hash_0}}/receipt

> {%
  client.test("响应状态码是否为200", function() {
    client.assert(response.status === 200, "响应状态码不是200");
    client.assert(response.body.hasOwnProperty('receipt'), "响应中缺少receipt字段");
    
    const receipt = response.body.receipt;
    // 验证必需字段
    client.assert(receipt.hasOwnProperty('transactionHash'), "收据缺少transactionHash字段");
    client.assert(receipt.hasOwnProperty('blockHash'), "收据缺少blockHash字段");
    client.assert(receipt.hasOwnProperty('blockNumber'), "收据缺少blockNumber字段");
    client.assert(receipt.hasOwnProperty('from'), "收据缺少from字段");
    client.assert(receipt.hasOwnProperty('to'), "收据缺少to字段");
    client.assert(receipt.hasOwnProperty('gasUsed'), "收据缺少gasUsed字段");
    client.assert(receipt.hasOwnProperty('status'), "收据缺少status字段");
    
    // 验证交易哈希是否与环境变量中的值匹配
    const expectedHash = client.global.get("tx_hash_0");
    client.assert(receipt.transactionHash === expectedHash, `交易哈希不匹配：API返回 ${receipt.transactionHash}，环境变量中为 ${expectedHash}`);
    
    // 验证from和to地址是否与环境变量中的值匹配
    const expectedFrom = client.global.get("from_0");
    const expectedTo = client.global.get("to_0");
    client.assert(receipt.from === expectedFrom, `发送方地址不匹配：API返回 ${receipt.from}，环境变量中为 ${expectedFrom}`);
    client.assert(receipt.to === expectedTo, `接收方地址不匹配：API返回 ${receipt.to}，环境变量中为 ${expectedTo}`);
    
    // 验证区块号是否等于height_minus_10
    const currentHeight = parseInt(client.global.get("height_minus_10"), 10);
    const receiptBlockNumber = parseInt(receipt.blockNumber, 10);
    client.assert(receiptBlockNumber === currentHeight, `区块号与height_minus_10不相等：${receiptBlockNumber} !== ${currentHeight}`);
  });
%}

### 获取多个地址的余额
GET http://localhost:8080/accounts/balances/{{from_0}},{{to_0}},{{from_1}},{{to_1}}?block={{height_minus_11}}

> {%
  client.test("响应状态码是否为200", function() {
    client.assert(response.status === 200, "响应状态码不是200");
    client.assert(response.body.hasOwnProperty('balances'), "响应中缺少balances字段");
    
    const balances = response.body.balances;
    // 验证所有地址的余额
    const addresses = ["from_0", "to_0", "from_1", "to_1"];
    addresses.forEach(key => {
      const address = client.global.get(key);
      client.assert(balances.hasOwnProperty(address), `缺少地址 ${address} 的余额`);
      const balance = balances[address];
      client.assert(typeof balance === "string", `地址 ${address} 的余额不是字符串类型`);
      client.assert(balance.length > 0, `地址 ${address} 的余额为空`);
      
      // 保存余额到环境变量
      client.global.set(`balance_${key}`, balance);
      client.log(`地址 ${address} 的余额：${balance}`);
    });
  });
%}

