### 获取最新区块高度，保存 height 和 height_minus_10 到环境变量

# curl --location 'http://localhost:8080/blocks/height/latest'
### 检查400状态码
GET http://localhost:8080/blocks/height/latest

> {%
  client.test("响应状态码是否为200", function() {
    client.assert(response.status === 200, "响应状态码不是200");
    const height = response.body.height;
    client.assert(typeof height === "string", "height 不是一个字符串");
    client.assert(parseInt(height, 10) > 0, "height 不是一个正数");
    
    // 保存原始高度
    client.global.set("height", height);
    client.log(`最新区块高度：${height}`);
    
    // 计算并保存height减10的值
    const heightMinus10 = (parseInt(height, 10) - 10).toString();
    client.global.set("height_minus_10", heightMinus10);
    client.log(`最新区块高度减10：${heightMinus10}`);
    
    // 计算并保存height减11的值
    const heightMinus11 = (parseInt(height, 10) - 11).toString();
    client.global.set("height_minus_11", heightMinus11);
    client.log(`最新区块高度减11：${heightMinus11}`);
  });
%}

### 获取指定区块信息，保存交易数量 txCount 和区块哈希 blockHash 到环境变量
GET http://localhost:8080/blocks/{{height_minus_10}}

> {%
  client.test("响应状态码是否为200", function() {
    client.assert(response.status === 200, "响应状态码不是200");
    client.assert(response.body.hasOwnProperty('block'), "响应中缺少block字段");
    
    // 验证transactions字段
    const block = response.body.block;
    client.assert(Array.isArray(block.transactions), "transactions不是数组类型");
    
    // 验证区块号与环境变量中的height不相等
    const currentHeight = client.global.get("height");
    client.assert(block.number !== currentHeight, `区块号与当前高度相等：${block.number}`);
    
    // 保存交易数量到环境变量
    const txCount = block.transactions.length;
    client.global.set("txCount", txCount.toString());
    client.log(`区块交易数量：${txCount}`);
    client.global.set("blockHash", block.hash);
    client.log(`区块哈希：${block.hash}`);
    
    // 验证transactions数组中的前三个交易对象
    const transactionsToCheck = block.transactions.slice(0, 3);
    transactionsToCheck.forEach((tx, index) => {
      // 验证必需字段
      client.assert(tx.hasOwnProperty('type'), `第${index}个交易缺少type字段`);
      client.assert(tx.hasOwnProperty('blockHash'), `第${index}个交易缺少blockHash字段`);
      client.assert(tx.hasOwnProperty('blockNumber'), `第${index}个交易缺少blockNumber字段`);
      client.assert(tx.hasOwnProperty('from'), `第${index}个交易缺少from字段`);
      client.assert(tx.hasOwnProperty('gas'), `第${index}个交易缺少gas字段`);
      client.assert(tx.hasOwnProperty('hash'), `第${index}个交易缺少hash字段`);
      client.assert(tx.hasOwnProperty('input'), `第${index}个交易缺少input字段`);
      client.assert(tx.hasOwnProperty('nonce'), `第${index}个交易缺少nonce字段`);
      client.assert(tx.hasOwnProperty('to'), `第${index}个交易缺少to字段`);
      client.assert(tx.hasOwnProperty('transactionIndex'), `第${index}个交易缺少transactionIndex字段`);
      
      // 验证type为3的交易特有字段
      if (tx.type === "3") {
        client.assert(tx.hasOwnProperty('maxFeePerBlobGas'), `第${index}个交易缺少maxFeePerBlobGas字段`);
        client.assert(tx.hasOwnProperty('blobVersionedHashes'), `第${index}个交易缺少blobVersionedHashes字段`);
        client.assert(Array.isArray(tx.blobVersionedHashes), `第${index}个交易的blobVersionedHashes不是数组类型`);
      }
    });
  });
%}

