### 获取最新区块中指定索引位置的交易信息
GET http://localhost:8080/blocks/transactions/0?number=latest

> {%
  client.test("响应状态码是否为200", function() {
    client.assert(response.status === 200, "响应状态码不是200");
    client.assert(response.body.hasOwnProperty('transaction'), "响应中缺少transaction字段");
    
    const tx = response.body.transaction;
    // 验证必需字段
    client.assert(tx.hasOwnProperty('type'), "交易缺少type字段");
    client.assert(tx.hasOwnProperty('blockHash'), "交易缺少blockHash字段");
    client.assert(tx.hasOwnProperty('blockNumber'), "交易缺少blockNumber字段");
    client.assert(tx.hasOwnProperty('from'), "交易缺少from字段");
    client.assert(tx.hasOwnProperty('gas'), "交易缺少gas字段");
    client.assert(tx.hasOwnProperty('hash'), "交易缺少hash字段");
    client.assert(tx.hasOwnProperty('input'), "交易缺少input字段");
    client.assert(tx.hasOwnProperty('nonce'), "交易缺少nonce字段");
    client.assert(tx.hasOwnProperty('to'), "交易缺少to字段");
    client.assert(tx.hasOwnProperty('transactionIndex'), "交易缺少transactionIndex字段");
    
    // 验证区块号与环境变量中的height差值是否小于等于3
    const currentHeight = parseInt(client.global.get("height"), 10);
    const txBlockNumber = parseInt(tx.blockNumber, 10);
    const heightDiff = Math.abs(currentHeight - txBlockNumber);
    client.assert(heightDiff <= 3, `区块号与当前高度差值过大：${heightDiff}`);
    
    // 验证type为3的交易特有字段
    if (tx.type === "3") {
      client.assert(tx.hasOwnProperty('maxFeePerBlobGas'), "交易缺少maxFeePerBlobGas字段");
      client.assert(tx.hasOwnProperty('blobVersionedHashes'), "交易缺少blobVersionedHashes字段");
      client.assert(Array.isArray(tx.blobVersionedHashes), "blobVersionedHashes不是数组类型");
    }
  });

  // 更新最新高度
  const newHeight = response.body.transaction.blockNumber;
  client.global.set("height", newHeight);
  client.log(`更新最新区块高度：${newHeight}`);
%}

