### 获取指定区块信息（不包含完整交易信息），保存前三个交易哈希到环境变量
GET http://localhost:8080/blocks/{{height_minus_10}}?fullTx=false

> {%
  client.test("响应状态码是否为200", function() {
    client.assert(response.status === 200, "响应状态码不是200");
    client.assert(response.body.hasOwnProperty('block'), "响应中缺少block字段");
    
    // 验证transactions字段
    const block = response.body.block;
    client.assert(Array.isArray(block.transactions), "transactions不是数组类型");
    
    // 验证区块号与环境变量中的height不相等
    const currentHeight = client.global.get("height");
    client.assert(block.number !== currentHeight, `区块号与当前高度相等：${block.number}`);
    
    // 验证transactions数组中的前三个交易哈希
    const transactionsToCheck = block.transactions.slice(0, 3);
    transactionsToCheck.forEach((txHash, index) => {
      client.assert(typeof txHash === "string", `第${index}个交易哈希不是字符串类型`);
      client.assert(txHash.startsWith("0x"), `第${index}个交易哈希不是以0x开头的十六进制字符串`);
      client.assert(txHash.length === 66, `第${index}个交易哈希长度不是66个字符`);
      
      // 保存交易哈希到环境变量
      client.global.set(`tx_hash_${index}`, txHash);
      client.log(`第${index}个交易哈希：${txHash}`);
    });
  });
%}

### 获取指定区块的交易数量（使用环境变量中的height）
GET http://localhost:8080/blocks/{{height_minus_10}}/transactions/count

> {%
  client.test("响应状态码是否为200", function() {
    client.assert(response.status === 200, "响应状态码不是200");
    client.assert(response.body.hasOwnProperty('count'), "响应中缺少count字段");
    const count = response.body.count;
    client.assert(typeof count === "string", "count 不是一个字符串");
    client.assert(parseInt(count, 10) >= 0, "count 不是一个非负数");
    
    // 验证count与环境变量中的txCount是否相等
    const txCount = client.global.get("txCount");
    client.assert(count === txCount, `交易数量不匹配：API返回 ${count}，环境变量中为 ${txCount}`);
  });
%}

### 获取指定区块中特定索引位置的交易信息（使用环境变量中的height）
GET http://localhost:8080/blocks/transactions/0?number={{height_minus_10}}

> {%
  client.test("响应状态码是否为200", function() {
    client.assert(response.status === 200, "响应状态码不是200");
    client.assert(response.body.hasOwnProperty('transaction'), "响应中缺少transaction字段");
    
    const tx = response.body.transaction;
    // 验证必需字段
    client.assert(tx.hasOwnProperty('type'), "交易缺少type字段");
    
    // 验证区块号与环境变量中的height不相等
    const currentHeight = client.global.get("height");
    client.assert(tx.blockNumber !== currentHeight, `区块号与当前高度相等：${tx.blockNumber}`);
    
    client.assert(tx.hasOwnProperty('blockHash'), "交易缺少blockHash字段");
    client.assert(tx.hasOwnProperty('blockNumber'), "交易缺少blockNumber字段");
    client.assert(tx.hasOwnProperty('from'), "交易缺少from字段");
    client.assert(tx.hasOwnProperty('gas'), "交易缺少gas字段");
    client.assert(tx.hasOwnProperty('hash'), "交易缺少hash字段");
    client.assert(tx.hasOwnProperty('input'), "交易缺少input字段");
    client.assert(tx.hasOwnProperty('nonce'), "交易缺少nonce字段");
    client.assert(tx.hasOwnProperty('to'), "交易缺少to字段");
    client.assert(tx.hasOwnProperty('transactionIndex'), "交易缺少transactionIndex字段");

    // 验证交易哈希是否与环境变量中的值匹配
    const expectedHash = client.global.get("tx_hash_0");
    client.assert(tx.hash === expectedHash, `交易哈希不匹配：API返回 ${tx.hash}，环境变量中为 ${expectedHash}`);
  
    // 保存交易的from和to地址到环境变量
    client.global.set("from_0", response.body.transaction.from);
    client.global.set("to_0", response.body.transaction.to);
    client.log(`交易发送方地址：${response.body.transaction.from}`);
    client.log(`交易接收方地址：${response.body.transaction.to}`);
  });
%}

