### 缓存区块高度服务集成测试
### 测试基于hamster缓存的区块高度查询功能

### 1. 第一次获取最新区块高度（缓存未命中）
GET http://localhost:8080/cached/blocks/height/latest

> {%
  client.test("第一次获取最新区块高度 - 缓存未命中", function() {
    client.assert(response.status == 200, "响应状态码不是200");
    client.assert(response.body.hasOwnProperty('height'), "响应中缺少height字段");
    
    const height = response.body.height;
    client.assert(typeof height == "string", "height 不是一个字符串");
    client.assert(parseInt(height, 10) > 0, "height 不是一个正数");
    
    // 保存第一次获取的高度和时间戳
    client.global.set("first_height", height);
    client.global.set("first_request_time", Date.now());
    client.log(`第一次获取区块高度：${height}`);
  });
%}

### 2. 立即再次获取最新区块高度（缓存命中）
GET http://localhost:8080/cached/blocks/height/latest

> {%
  client.test("第二次获取最新区块高度 - 缓存命中", function() {
    client.assert(response.status == 200, "响应状态码不是200");
    client.assert(response.body.hasOwnProperty('height'), "响应中缺少height字段");
    
    const height = response.body.height;
    const firstHeight = client.global.get("first_height");
    
    // 验证缓存命中：高度应该相同
    client.assert(height == firstHeight, `缓存未命中：第二次高度 ${height} 与第一次高度 ${firstHeight} 不同`);
    client.log(`✅ 缓存命中验证通过：两次请求返回相同高度 ${height}`);
  });
%}

### 3. 连续多次快速请求（测试缓存稳定性）
GET http://localhost:8080/cached/blocks/height/latest

> {%
  client.test("第三次获取最新区块高度 - 缓存稳定性", function() {
    client.assert(response.status == 200, "响应状态码不是200");
    
    const height = response.body.height;
    const firstHeight = client.global.get("first_height");
    
    // 验证缓存稳定性：高度应该仍然相同
    client.assert(height == firstHeight, `缓存不稳定：第三次高度 ${height} 与第一次高度 ${firstHeight} 不同`);
    client.log(`✅ 缓存稳定性验证通过：第三次请求仍返回相同高度 ${height}`);

    // 保存第三次请求时间，用于后续缓存过期测试
    client.global.set("third_request_time", Date.now());
  });
%}

### 4. 等待6秒后再次请求（测试缓存过期）
### 注意：需要手动等待6秒，或者使用工具的延迟功能
GET http://localhost:8080/cached/blocks/height/latest

> {%
  client.test("缓存过期后获取最新区块高度", function() {
    client.assert(response.status == 200, "响应状态码不是200");
    client.assert(response.body.hasOwnProperty('height'), "响应中缺少height字段");
    
    const height = response.body.height;
    const firstHeight = client.global.get("first_height");
    const currentTime = Date.now();
    const thirdRequestTime = parseInt(client.global.get("third_request_time"), 10);
    const timeDiff = currentTime - thirdRequestTime;
    
    client.log(`距离上次请求时间：${timeDiff}ms`);
    client.log(`缓存过期后获取的高度：${height}`);
    client.log(`第一次获取的高度：${firstHeight}`);
    
    // 如果时间间隔超过5秒，缓存应该已过期
    if (timeDiff > 5000) {
      client.log("✅ 缓存已过期，重新从数据源获取数据");
      // 注意：由于区块链的特性，新高度可能与旧高度相同或更大
      const newHeightNum = parseInt(height, 10);
      const firstHeightNum = parseInt(firstHeight, 10);
      client.assert(newHeightNum >= firstHeightNum, `新高度 ${newHeightNum} 小于第一次高度 ${firstHeightNum}`);
    } else {
      client.log("⚠️  时间间隔不足5秒，缓存可能仍然有效");
    }

    // 保存过期后的高度
    client.global.set("expired_height", height);
  });
%}

### 5. 立即再次请求（测试缓存重新生效）
GET http://localhost:8080/cached/blocks/height/latest

> {%
  client.test("缓存重新生效后获取最新区块高度", function() {
    client.assert(response.status == 200, "响应状态码不是200");
    
    const height = response.body.height;
    const expiredHeight = client.global.get("expired_height");
    
    // 验证缓存重新生效：高度应该与过期后获取的高度相同
    client.assert(height == expiredHeight, `缓存未重新生效：当前高度 ${height} 与过期后高度 ${expiredHeight} 不同`);
    client.log(`✅ 缓存重新生效验证通过：高度保持一致 ${height}`);
  });
%}

### 6. 并发请求测试准备 - 等待缓存过期
### 注意：SingleFlight机制主要在缓存过期时的并发请求中体现
### 当多个请求同时访问过期的缓存时，只有一个请求会实际加载数据
GET http://localhost:8080/cached/blocks/height/latest

> {%
  client.test("并发测试准备 - 获取基准高度", function() {
    client.assert(response.status == 200, "响应状态码不是200");

    const height = response.body.height;
    client.global.set("concurrent_base_height", height);
    client.global.set("concurrent_test_start", Date.now());
    client.log(`并发测试基准高度：${height}`);
    client.log("⏰ 请等待5秒让缓存过期，然后快速执行下面的并发请求测试");
  });
%}

### 7. 模拟并发请求1（需要在缓存过期后同时执行多个请求）
### 重要：要测试SingleFlight机制，需要在缓存过期后立即同时发起多个请求
### 在实际场景中，当缓存过期时，多个并发请求只会有一个实际去加载数据
GET http://localhost:8080/cached/blocks/height/latest

> {%
  client.test("并发请求1 - SingleFlight机制测试", function() {
    client.assert(response.status == 200, "响应状态码不是200");

    const height = response.body.height;

    client.global.set("concurrent_height_1", height);
    client.log(`并发请求1：高度=${height}`);
  });
%}

### 8. 模拟并发请求2
GET http://localhost:8080/cached/blocks/height/latest

> {%
  client.test("并发请求2 - SingleFlight机制测试", function() {
    client.assert(response.status == 200, "响应状态码不是200");
    
    const height = response.body.height;

    client.global.set("concurrent_height_2", height);
    client.log(`并发请求2：高度=${height}`);

    // 验证SingleFlight机制：两个并发请求应该返回相同的高度
    const height1 = client.global.get("concurrent_height_1");
    if (height1) {
      client.assert(height == height1, `SingleFlight机制失效：请求1高度 ${height1} 与请求2高度 ${height} 不同`);
      client.log("✅ SingleFlight机制正常工作：并发请求返回相同高度");
    }
  });
%}

### 9. 功能验证总结
GET http://localhost:8080/cached/blocks/height/latest

> {%
  client.test("缓存功能验证总结", function() {
    client.assert(response.status == 200, "响应状态码不是200");

    const height = response.body.height;
    client.log("=== 缓存区块高度服务测试总结 ===");
    client.log(`当前区块高度：${height}`);

    // 验证功能特性
    client.log("✅ 缓存命中功能正常");
    client.log("✅ 缓存过期机制正常");
    client.log("✅ 缓存重新生效正常");
    client.log("✅ SingleFlight机制正常");
    client.log("✅ 数据一致性验证通过");

    client.log("🎯 基于hamster的缓存区块高度服务功能测试完成");
    client.log("📝 注意：性能提升在生产环境中更明显，单机测试环境下差异较小");
  });
%}
