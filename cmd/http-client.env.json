{
  "dev": {
    "height": "{{response.body.height}}",
    "height_minus_10": "{{parseInt(response.body.height, 10) - 10}}",
    "height_minus_11": "{{parseInt(response.body.height, 10) - 11}}",
    "blockHash": "{{response.body.block.hash}}",
    "txCount": "{{response.body.block.transactions.length}}",
    "tx_hash_0": "{{response.body.block.transactions[0]}}",
    "tx_hash_1": "{{response.body.block.transactions[1]}}",
    "tx_hash_2": "{{response.body.block.transactions[2]}}",
    "from_0": "{{response.body.transaction.from}}",
    "to_0": "{{response.body.transaction.to}}",
    "from_1": "{{response.body.transaction.from}}",
    "to_1": "{{response.body.transaction.to}}",
    "from_2": "{{response.body.transaction.from}}",
    "to_2": "{{response.body.transaction.to}}",
    "balance_from_0": "{{response.body.balances[client.global.get('from_0')]}}",
    "balance_to_0": "{{response.body.balances[client.global.get('to_0')]}}",
    "balance_from_1": "{{response.body.balances[client.global.get('from_1')]}}",
    "balance_to_1": "{{response.body.balances[client.global.get('to_1')]}}"
  }
}